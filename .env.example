# REQUIRED: JWT Secret Key for authentication (generate a secure random string)
# Example: openssl rand -hex 32
SECRET_KEY=your-secret-key-here-CHANGE-THIS

# OpenAI API Configuration (optional - for AI-powered recommendations)
OPENAI_API_KEY=your-openai-api-key-here

# Database Configuration (SQLite by default)
DATABASE_URL=sqlite:///./k8s_analysis.db

# Server Configuration
HOST=0.0.0.0
PORT=8000

# CORS Configuration (comma-separated list, use * for development only)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Development Mode (set to false in production)
DEV_MODE=true
